__pycache__/
*.pyc
.DS_Store
venv/
.venv/
*.egg-info/

# data — large files not committed
data/audio/
data/fma_metadata/
data/mpd_dump/
data/billboard/
data/*.zip

# derived eval-embedding checkpoints — regenerate via `tagging embed-eval`
data/fma_eval_embeddings.npz*

# model artifacts — all derived, not committed
models/

# generated viz exports — regenerate via export_viz.py / export_corpus_viz.py
/song_view.html
/corpus_*_view.html

# UI session/runtime state — dirs kept via .gitkeep, contents ignored
ui/session/*.sqlite
ui/session/graph.json
ui/session/uploads/*
!ui/session/uploads/.gitkeep
ui/session/*

# jupyter checkpoints
.ipynb_checkpoints/

# pytest / build caches
.pytest_cache/

# env
.env

# vendored binaries (not source)
vendor/
*.dmg
docs/*.pdf
scripts/deploy/dryrun_tmp/

# runtime logs & ad-hoc debug scratch — never committed
logs/
*.log

# scratch working dirs — throwaway bundle copies / stale exports
_scratch_test/
_workspace_export/
scratch.txt
*.diff

# private working material — strategy docs, completed plan archive,
# eval results kept locally (see private/README.md)
private/

# exploratory analysis output at repo root — notebooks, CSVs, figures
/*.ipynb
/*.csv
/*.png
